FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 BX_DATA_DIR=/data
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg fonts-noto-cjk && rm -rf /var/lib/apt/lists/* && useradd --create-home --uid 10001 bxagi && mkdir -p /app /data && chown -R bxagi:bxagi /app /data
WORKDIR /app
COPY --chown=bxagi:bxagi backend/ backend/
COPY --chown=bxagi:bxagi legacy/workspace/ legacy/workspace/
USER bxagi
EXPOSE 8765
VOLUME ["/data"]
CMD ["python", "backend/server.py", "--host", "0.0.0.0", "--port", "8765", "--data-dir", "/data"]
